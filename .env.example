# Copia questo file in ".env" e compila i valori. ".env" NON va mai committato (repo pubblico).
# Gli stessi nomi vanno configurati come GitHub Actions Secrets (report agentico)
# e, per GEMINI_API_KEY, come Environment Variable del progetto Vercel del Menu (chat AI).

GEMINI_API_KEY=
# Opzionale: catena modelli per il report (ordine di priorità, separati da virgola)
# AGENT_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-flash-latest
# Opzionale: catena modelli per la chat del menu (/api/chat)
# GEMINI_CHAT_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite

GMAIL_APP_PASSWORD=
NEXT_PUBLIC_CONTACT_EMAIL=

VERCEL_TOKEN=
GITHUB_TOKEN=

META_READ_ONLY_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_PAGE_ID=
INSTAGRAM_PROFILE_URL=
FACEBOOK_PROFILE_URL=
